#!/usr/bin/env bash
# Prime Autonomous Platform CLI Entrypoint (Linux / macOS)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

if command -v node >/dev/null 2>&1; then
    node "$ROOT_DIR/scripts/prime-router.js" "$@"
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -ExecutionPolicy Bypass -File "$SCRIPT_DIR/prime.ps1" "$@"
else
    echo "Prime CLI requires Node.js or PowerShell (pwsh) to be installed."
    exit 1
fi
